root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120

# ktlint standard rules
ktlint_standard = enabled
ktlint_function_naming_ignore_when_annotated_with = Composable

# Allow wildcard imports
ktlint_standard_no-wildcard-imports = disabled

# Compose-specific rules (io.nlopez.compose.rules)
ktlint_compose_compositionlocal-allowlist = disabled
ktlint_compose_preview-public-check = disabled
ktlint_compose_naming-check = enabled
ktlint_compose_composable-function-name = enabled
ktlint_compose_modifier-missing-check = disabled
ktlint_compose_unstable-collections =
