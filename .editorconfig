root = true

[*.{kt,kts}]
charset=utf-8
end_of_line=lf
indent_style=space
indent_size=4
insert_final_newline=true
max_line_length=120

ktlint_code_style=ktlint_official

# Relaxed rules for easier development
ktlint_standard_no-wildcard-imports=disabled
ktlint_standard_function-naming=disabled
ktlint_standard_filename=disabled
ktlint_standard_property-naming=disabled
ktlint_compose_modifier-missing-check=disabled
ktlint_compose_modifier-reused=disabled
ktlint_compose_modifier-without-default=disabled
ktlint_compose_lambda-naming=disabled
ktlint_compose_compositionlocal-allowlist=disabled